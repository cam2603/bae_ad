{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework", "@wdio/appium-service"]
  },
  "include": ["wdio.conf.ts", "config/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "test-data/**/*.ts"]
}
