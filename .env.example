# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Môi trường Android ---
# Thư mục chứa platform-tools (adb). Appium cần biến này.
ANDROID_HOME=C:\path\to\android-sdk
# Lấy từ `adb devices`. Với ADB qua Wi-Fi, port có thể đổi sau mỗi lần ghép nối.
DEVICE_UDID=<ip-thiet-bi>:<port>


# --- Ứng dụng (đã xác minh trên thiết bị, bản Test.6.10.190) ---
APP_PACKAGE=com.binhanh.admin.baexpress
APP_ACTIVITY=crc641270b358e0f1d280.SplashActivity

# --- Appium ---
APPIUM_PORT=4723

# --- Tài khoản test (LOGIN-008) ---
# Tài khoản trên môi trường TEST. Nếu để trống TEST_PASSWORD, LOGIN-008 sẽ dùng
# thông tin đã lưu sẵn trên màn Login, với điều kiện ô tài khoản đang hiển thị đúng TEST_USERNAME.
TEST_USERNAME=
TEST_PASSWORD=

# --- Dữ liệu không hợp lệ (LOGIN-007) ---
# Nên dùng tài khoản KHÔNG tồn tại để tránh khóa tài khoản thật.
INVALID_USERNAME=auto_khongtontai_001
INVALID_PASSWORD=Abc12345
